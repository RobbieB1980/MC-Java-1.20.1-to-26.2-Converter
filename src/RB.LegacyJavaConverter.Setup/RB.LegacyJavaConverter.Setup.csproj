<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RB-Legacy-Java-Converter-Setup</AssemblyName>
    <RootNamespace>RB.LegacyJavaConverter.Setup</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Product>RB Legacy Java Converter Setup</Product>
    <Company>RobbieB1980</Company>
    <Version>1.5.3</Version>
    <FileVersion>1.5.3</FileVersion>
    <InformationalVersion>1.5.3</InformationalVersion>
    <Description>Installer for RB Legacy Java Converter (portable toolset)</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\dist\portable-payload.zip"
                      Condition="Exists('..\..\dist\portable-payload.zip')"
                      LogicalName="portable-payload.zip" />
  </ItemGroup>

</Project>
