    },
    "mixinextras": {
      "aliases": ["mixinextras", "mixinextras_common"],
      "reason": "Annotation library bundled by NeoForge/ModDevGradle."
    },
    "flywheel": {
      "aliases": ["flywheel", "flywheel_backend"],
      "modrinth": "flywheel",
      "reason": "Rendering engine — too large and loader-specific to auto-convert."
    },
    "create": {
      "aliases": ["create"],
      "modrinth": "create",
      "reason": "Too large for automatic jar conversion; require an official 26.2 port."
    },
    "fabric_api": {
      "aliases": ["fabric-api", "fabric_api"],
      "reason": "Wrong loader."
    }
